# Chave usada para criptografar a senha SMTP no Neon.
# Gere uma chave forte, por exemplo: openssl rand -base64 48
EVENTHUB_SETTINGS_ENCRYPTION_KEY=

# Resend continua disponível quando o provedor selecionado for "resend".
RESEND_API_KEY=

# Fallback opcional. Normalmente as credenciais serão cadastradas no painel.
SMTP_USER=
SMTP_PASSWORD=
